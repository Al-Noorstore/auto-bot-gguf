<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- TERMINAL (real Android shell, background bot bhi use karta hai) -->
    <LinearLayout
        android:id="@+id/terminalScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0d1117"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖥 Terminal"
                android:textColor="#10a37f"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTermCopy"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⧉"
                android:textColor="#9b9b9b"
                android:textSize="16sp"
                android:background="#00000000" />

            <Button
                android:id="@+id/btnTermAdd"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+"
                android:textColor="#10a37f"
                android:textSize="18sp"
                android:background="#00000000" />

            <Button
                android:id="@+id/btnTermClear"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Clear"
                android:textColor="#9b9b9b"
                android:textSize="12sp"
                android:background="#00000000" />

            <Button
                android:id="@+id/btnTermClose"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✕"
                android:textColor="#9b9b9b"
                android:textSize="15sp"
                android:background="#00000000" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161b22"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/termTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/termScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/termOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#c9d1d9"
                android:textSize="12sp"
                android:padding="12dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#161b22"
            android:padding="8dp">

            <EditText
                android:id="@+id/termIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sh command..."
                android:textColorHint="#6b6b6b"
                android:textColor="#c9d1d9"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/btnTermRun"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:text="▶"
                android:textColor="#000000"
                android:textSize="16sp"
                android:background="#10a37f" />
        </LinearLayout>
    </LinearLayout>

    <!-- v3.0: BROWSER — in-app multi-tab WebView -->
    <LinearLayout
        android:id="@+id/browserScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0d1117"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌐 Browser"
                android:textColor="#10a37f"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWebAdd"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+"
                android:textColor="#10a37f"
                android:textSize="18sp"
                android:background="#00000000" />

            <Button
                android:id="@+id/btnWebClose"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✕"
                android:textColor="#9b9b9b"
                android:textSize="15sp"
                android:background="#00000000" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161b22"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/webTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#161b22"
            android:padding="8dp">

            <EditText
                android:id="@+id/webIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="URL ya search..."
                android:textColorHint="#6b6b6b"
                android:textColor="#c9d1d9"
                android:textSize="13sp"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/btnWebGo"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:text="▶"
                android:textColor="#000000"
                android:textSize="16sp"
                android:background="#10a37f" />
        </LinearLayout>
    </LinearLayout>

    <!-- NATIVE POWERS PANEL (site sidebar se khulta hai) -->
    <ScrollView
        android:id="@+id/nativeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#212121"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/btnCloseNative"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="← Wapas"
                android:textColor="#10a37f"
                android:background="#2f2f2f"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Native Powers"
                android:textColor="#10a37f"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real contact book, direct calls, WhatsApp"
                android:textColor="#9b9b9b"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Naam (e.g. Ali Khan)"
                android:textColorHint="#6b6b6b"
                android:textColor="#ececec"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Number (e.g. +923001234567)"
                android:textColorHint="#6b6b6b"
                android:textColor="#ececec"
                android:inputType="phone"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 Phone Contact Book Mein Save Karo"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAutoCall"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📞 Auto Call (bina dialer ke)"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💬 WhatsApp Chat Kholo"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnShareCrash"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📤 Crash Log Share Karo"
                android:textColor="#9b9b9b"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#10a37f"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
